{
    "issuer": "https://auth.cloverleaf.ai/",
    "authorization_endpoint": "https://auth.cloverleaf.ai/authorize",
    "token_endpoint": "https://auth.cloverleaf.ai/oauth/token",
    "registration_endpoint": "https://auth.cloverleaf.ai/oidc/register",
    "revocation_endpoint": "https://auth.cloverleaf.ai/oauth/revoke",
    "response_types_supported": [
        "code"
    ],
    "grant_types_supported": [
        "authorization_code",
        "refresh_token"
    ],
    "code_challenge_methods_supported": [
        "S256"
    ],
    "token_endpoint_auth_methods_supported": [
        "client_secret_post",
        "client_secret_basic",
        "none"
    ],
    "scopes_supported": [
        "openid",
        "profile",
        "email",
        "offline_access"
    ]
}
